# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Create project at https://supabase.com
# Get connection string from Settings → Database → Connection Pooling
