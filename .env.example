# ── AI Models (OpenRouter) ────────────────────────────────────
# Get API key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-[...your-key...]
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter primary model selection
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-2-70b-chat
OPENROUTER_FALLBACK_MODEL=gpt-3.5-turbo
OPENROUTER_ALTERNATIVE_MODEL=claude-instant

# ── Vector Database (Pinecone) ────────────────────────────────
# Create index at https://app.pinecone.io
# Skip if not using RAG features
PINECONE_API_KEY=pcsk_[...your-key...]
PINECONE_INDEX_NAME=lightline-ministry
PINECONE_REGION=us-east-1

# ── Logging & Monitoring ──────────────────────────────────────
LOG_LEVEL=info
DEBUG=false

# ════════════════════════════════════════════════════════════
