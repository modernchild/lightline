# ── Media Storage (Cloudinary) ────────────────────────────────
# Create account at https://cloudinary.com
# Get credentials from Dashboard
CLOUDINARY_CLOUD_NAME=decwmfbdr
CLOUDINARY_API_KEY=354968517845274
CLOUDINARY_API_SECRET=wdW1_0Gg72ywqJEsTb_c-ifkBFw
